{
  "name": "atelier-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178 --strictPort",
    "predev": "node scripts/write-firebase-config.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort",
    "check": "node --check scripts/build.mjs && node --check vite.config.js && node --check scripts/check-rules.mjs",
    "test:rules": "firebase emulators:exec --project demo-atelier --only auth,firestore \"node scripts/check-rules.mjs\"",
    "tauri": "tauri",
    "desktop:icons": "tauri icon icon.svg --output src-tauri/icons",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:mac": "tauri build --bundles app,dmg",
    "desktop:build:windows": "tauri build --bundles msi,nsis"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1"
  }
}
