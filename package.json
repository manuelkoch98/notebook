{
  "name": "atelier-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --check app.js && node --check scripts/serve.mjs && node --check scripts/check-rules.mjs",
    "test:rules": "firebase emulators:exec --project demo-atelier --only auth,firestore \"node scripts/check-rules.mjs\"",
    "tauri": "tauri",
    "desktop:icons": "tauri icon icon.svg --output src-tauri/icons",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:mac": "tauri build --bundles app,dmg",
    "desktop:build:windows": "tauri build --bundles msi,nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
