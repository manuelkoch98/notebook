{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier",
  "version": "0.1.0",
  "identifier": "com.manuelkoch98.atelier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atelier — Wissenswerkstatt",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Persönliche Markdown-Wissenswerkstatt",
    "longDescription": "Atelier ist ein persönlicher Markdown-Arbeitsbereich zum Schreiben und Verbinden von Notizen."
  }
}
