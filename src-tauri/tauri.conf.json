{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atelier",
  "version": "0.1.8",
  "identifier": "com.manuelkoch98.atelier",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:4193",
    "beforeBuildCommand": "npm run build && npm run desktop:icons",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "atelier",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Pers\u00f6nliche Markdown-Wissenswerkstatt",
    "longDescription": "atelier ist ein pers\u00f6nlicher Markdown-Arbeitsbereich zum Schreiben und Verbinden von Notizen.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRjQxOUEyQkQ3Mjg1QUMKUldTc2hYSzlvaG4wcS96Ymp3SXV0TnRIY0VFZnVMMVhkQ1NUU0hvMXltN2FvZWNDMGgzVVlvRlMK",
      "endpoints": [
        "https://github.com/manuelkoch98/notebook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
